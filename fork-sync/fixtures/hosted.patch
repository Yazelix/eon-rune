+    /// Rune hosting spike: a renderer on a host's device and queue that draws the terminal layer
+    /// into the host's render pass. No window, surface or presentation; `size` is the sub-rect the
+    /// host gives it (the host sets the pass viewport to that rect).
+    pub fn hosted(
+        device: wgpu::Device,
+        queue: wgpu::Queue,
+        format: wgpu::TextureFormat,
+        size: (u32, u32),
+        scale_factor: f64,
+        fonts: FontSetup,
+    ) -> Result<Self, RenderError> {
+        let config = SurfaceConfiguration {
+            usage: wgpu::TextureUsages::RENDER_ATTACHMENT,
+            format,
+            color_space: Default::default(),
+            width: size.0.max(1),
+            height: size.1.max(1),
+            present_mode: PresentMode::Fifo,
+            desired_maximum_frame_latency: 2,
+            alpha_mode: CompositeAlphaMode::Opaque,
+            view_formats: Vec::new(),
+        };
+        Self::assemble(
+            None,
+            None,
+            None,
+            device,
+            Arc::new(AtomicBool::new(false)),
+            queue,
+            config,
+            scale_factor,
+            false,
+            1.0,
+            PaddingColor::default(),
+            None,
+            false,
+            false,
+            SceneColor::default(),
+            1,
+            1,
+            None,
+            fonts,
+        )
+    }
+
